{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "hello": "tsx ./src/hello.ts",
    "demo:seed": "node --require ./tsx-windows.cjs --env-file=../artifacts/api-server/.env --import tsx ./src/mushroom-demo-data.ts seed",
    "demo:clear": "node --require ./tsx-windows.cjs --env-file=../artifacts/api-server/.env --import tsx ./src/mushroom-demo-data.ts clear",
    "migrate:mongodb": "tsx ./migrate-postgresql-to-mongodb.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@workspace/db": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "mongoose": "^8.19.4",
    "pg": "^8.22.0",
    "tsx": "catalog:"
  }
}
