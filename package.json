{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node ./scripts/ensure-pnpm.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "build:demo": "node ./scripts/build-environment.mjs demo",
    "build:staging": "node ./scripts/build-environment.mjs staging",
    "build:prod": "node ./scripts/build-environment.mjs prod",
    "build:client:demo": "node ./scripts/build-environment.mjs demo --client-only",
    "build:client:staging": "node ./scripts/build-environment.mjs staging --client-only",
    "build:client:prod": "node ./scripts/build-environment.mjs prod --client-only",
    "build:server:demo": "node ./scripts/build-environment.mjs demo --server-only",
    "build:server:staging": "node ./scripts/build-environment.mjs staging --server-only",
    "build:server:prod": "node ./scripts/build-environment.mjs prod --server-only",
    "test:build-package": "node --test ./scripts/build-package.test.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "demo:data:seed": "pnpm --filter @workspace/scripts run demo:data:seed",
    "demo:data:clear": "pnpm --filter @workspace/scripts run demo:data:clear",
    "staging:data:seed": "pnpm --filter @workspace/scripts run staging:data:seed",
    "staging:data:clear": "pnpm --filter @workspace/scripts run staging:data:clear",
    "production:data:seed": "pnpm --filter @workspace/scripts run production:data:seed",
    "production:data:clear": "pnpm --filter @workspace/scripts run production:data:clear"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.8.4",
    "typescript": "~5.9.3"
  }
}
