MONGODB_URI=mongodb://127.0.0.1:27017/vidhai
SESSION_SECRET=replace-with-a-long-random-secret
PORT=5000
NODE_ENV=development
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-secure-initial-password
BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173
UPLOAD_ROOT=./uploads
NOTIFICATION_WORKER_CONCURRENCY=4
NOTIFICATION_WORKER_POLL_MS=1000
NOTIFICATION_JOB_ATTEMPTS=5
JWT_ACCESS_SECRET=replace-with-a-different-strong-random-secret
JWT_REFRESH_SECRET=replace-with-another-strong-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_REFRESH_COOKIE_MAX_AGE_MS=604800000
JWT_COOKIE_SAME_SITE=lax
SESSION_COOKIE_MAX_AGE_MS=604800000
SESSION_COOKIE_SAME_SITE=lax
LEDGER_AP_REQUIRED_APPROVALS=1
LEDGER_AR_REQUIRED_APPROVALS=1
FLEX_VENDOR_PAYMENT_REQUIRED_APPROVALS=1
